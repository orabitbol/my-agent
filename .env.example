# Copy this file to ".env" and fill in your key. ".env" is never committed to git.
OPENAI_API_KEY=
# Text model used by the agent loop. Any model that supports the Responses API.
OPENAI_MODEL=gpt-5.5

# Voice (optional: these are the defaults).
# The speech-to-speech model, its voice, and the model that writes down what you said.
OPENAI_VOICE_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Microphone noise filter: far_field (laptop microphone), near_field (headset) or off.
OPENAI_VOICE_NOISE=far_field

# The investment portfolio (optional). The agent reads it from your own site.
# The key is one long secret: the same value as AGENT_API_KEY in the site's settings.
POSITIONHERO_AGENT_KEY=
# The site's address. This is the default.
POSITIONHERO_URL=https://www.positionhero.com

# The desk device (optional). A long secret the device shows when it asks this
# computer to start a voice call. Without it, nothing listens on the network.
DEVICE_KEY=
# The port the device connects to on this computer. This is the default.
DEVICE_PORT=8787
